# Values for automation/.env (n8n), agreed with the monitoring owner (Keshan).
# Copy these lines into automation/.env. scripts/check_stack.py runs every
# PROM_QUERY_* below against the live Prometheus, so this file is what is tested.
# {{service}} is replaced by the service name; for testing it is sample-app.

# --- Alert intake (workflow 01) ---
ALERT_SERVICE_LABEL=service

# --- Loki (workflow 02) ---
LOKI_URL=http://host.docker.internal:3100
LOKI_SERVICE_LABEL=service

# --- Prometheus (workflows 03 and 07) ---
PROMETHEUS_URL=http://host.docker.internal:9090
PROM_SERVICE_LABEL=service
# "or vector(0)" returns 0 instead of no data when there are no 5xx responses.
# 2m window, not 5m: workflow 07 checks 3 times, 60 s apart. Measured 13 Nov 2026
# after a real restart: the 2m ratio was 0 after about 100 s, the 5m ratio was
# still 0.2 after 3 minutes, so 07 answered not_recovered with a 5m window.
# The HighErrorRate alert keeps 5m (fewer false alarms).
PROM_QUERY_ERROR_RATE=(sum(rate(http_requests_total{service="{{service}}",status=~"5.."}[2m])) or vector(0)) / sum(rate(http_requests_total{service="{{service}}"}[2m]))
PROM_QUERY_LATENCY_P95=histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service="{{service}}"}[5m])))
PROM_QUERY_REQUEST_RATE=sum(rate(http_requests_total{service="{{service}}"}[5m]))
# CPU and memory: leave empty, the workflow 03 defaults (process_cpu_seconds_total,
# process_resident_memory_bytes) exist in sample-app.
PROM_QUERY_CPU=
PROM_QUERY_MEMORY=
PROM_THRESHOLD_ERROR_RATE=0.05
PROM_THRESHOLD_LATENCY_P95=0.5
