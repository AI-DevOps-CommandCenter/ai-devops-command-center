# Monitoring stack settings for monitoring/docker-compose.yml.
# Copy to monitoring/.env (git-ignored), or run `node scripts/setup-local.mjs`
# from the repository root: it creates this file and fills in the secret below.
# The Alertmanager -> n8n token is NOT here: it lives in
# alertmanager/secrets/n8n-token (git-ignored, created by the same script).

# Keep 127.0.0.1: only this computer can open Prometheus, Alertmanager, Loki and the executor.
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
EXECUTOR_PORT=9095

# Playbook executor: HMAC secret (32+ chars) for the requests n8n workflow 06 sends.
# Local-only, generated per developer. Same value as EXECUTOR_SIGNING_SECRET in
# automation/.env. Empty = the executor answers 503 to everything.
EXECUTOR_SIGNING_SECRET=

# Image versions (pinned; checked on Docker Hub 13 Nov 2026).
PROMETHEUS_VERSION=v3.15.1
ALERTMANAGER_VERSION=v0.34.2
LOKI_VERSION=3.7.9
# Promtail has had no release since 3.6.11 (May 2026); see D-MON-4.
PROMTAIL_VERSION=3.6.11

# Requests per second from the load generator to sample-app.
LOADGEN_RPS=5
