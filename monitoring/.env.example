# Monitoring stack settings for monitoring/docker-compose.yml.
# Copy to monitoring/.env to change them. No secrets here: the n8n webhook token
# lives in alertmanager/secrets/n8n-token (gitignored).

# Keep 127.0.0.1: only this computer can open Prometheus, Alertmanager and Loki.
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# Image versions (pinned; checked on Docker Hub 13 Nov 2026).
PROMETHEUS_VERSION=v3.15.1
ALERTMANAGER_VERSION=v0.34.2
LOKI_VERSION=3.7.9
# Promtail has had no release since 3.6.11 (May 2026); see D-MON-4.
PROMTAIL_VERSION=3.6.11

# Requests per second from the load generator to sample-app.
LOADGEN_RPS=5
