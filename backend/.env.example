# Backend configuration. Copy to backend/.env (or run `node scripts/setup-local.mjs`
# from the repository root) and fill in. Never commit backend/.env.
# backend/.env is read first, then the repository-root .env; the first value wins.
# Where each value comes from: docs/SETUP.md.

# ===== Supabase (required, shared privately by the team lead) =====
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key only. Secret/service_role keys are refused at startup.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# ===== Server =====
PORT=3000
# Comma-separated browser origins (Flutter web). Native apps are not affected.
CORS_ORIGINS=http://localhost:8080
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# TRUST_PROXY=0

# ===== n8n machine endpoints (/api/machine/*) =====
# All three are needed; otherwise the machine endpoints answer 503.
# Local-only, generated by scripts/setup-local.mjs (32+ chars).
# Same value as MACHINE_SIGNING_SECRET in automation/.env.
MACHINE_SIGNING_SECRET=
# Supabase user with profiles.role = 'automation' (shared privately by the team lead).
AUTOMATION_EMAIL=automation@demo.local
AUTOMATION_PASSWORD=

# ===== Remediation webhook (BD-5) =====
# The backend calls n8n workflow 06 after an approval. HTTPS outside localhost.
N8N_REMEDIATION_WEBHOOK_URL=http://127.0.0.1:5678/webhook/remediation
# Outbox: approved runs that did not reach n8n are sent again every N ms
# (needs the automation identity; 0 = off). Migration 20261118000200.
REMEDIATION_OUTBOX_INTERVAL_MS=30000

# ===== Monitoring read APIs for the app (/api/metrics, /api/logs) =====
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100

# ===== GitHub read API for the app (/api/github) =====
# Your OWN fine-grained, read-only token: Metadata, Contents, Pull requests, Actions.
# Optional: without it only the CI/CD screens stay empty.
GITHUB_TOKEN=
# Allow-list, comma-separated owner/repo.
GITHUB_REPOSITORIES=AI-DevOps-CommandCenter/ai-devops-command-center

# ===== Notification worker (npm run worker:notifications:dev), optional =====
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# NOTIFICATION_WORKER_POLL_INTERVAL_MS=
# NOTIFICATION_WORKER_BATCH_SIZE=

# ===== Local test accounts (scripts/check-project.mjs and manual tests only) =====
# Demo passwords are shared privately; never commit them.
# TEST_USER_EMAIL=demo.admin@demo.local
# TEST_USER_PASSWORD=
# TEST_REQUESTER_EMAIL=demo.requester@demo.local
# TEST_REQUESTER_PASSWORD=
