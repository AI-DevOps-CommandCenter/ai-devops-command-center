# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials to Git.

# ===== General =====
NODE_ENV=development

# ===== Backend API =====
API_PORT=3000
API_JWT_SECRET=your_random_long_secret_here

# ===== Groq AI =====
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_name_here

# ===== Supabase Database =====
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# ===== Monitoring =====
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
ALERTMANAGER_URL=http://alertmanager:9093

# ===== n8n =====
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# ===== Alertmanager =====
ALERTMANAGER_WEBHOOK_SECRET=your_alertmanager_webhook_secret_here

# ===== GitHub =====
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_deployed_app_repo_name

# ===== GitLab =====
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=your_gitlab_project_id

# ===== AWS =====
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=your_aws_region_here
AWS_EC2_HOST=your_ec2_public_ip_or_dns_here

# ===== Firebase Notifications =====
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
