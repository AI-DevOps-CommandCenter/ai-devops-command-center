# No repository-root .env is needed.
#
# Every service has its own git-ignored .env, created from its own example:
#   backend/.env      <- backend/.env.example      (Supabase, signing secret, automation user, URLs)
#   automation/.env   <- automation/.env.example   (n8n, Groq model, Prometheus/Loki queries)
#   monitoring/.env   <- monitoring/.env.example   (ports, image versions, executor secret)
#
# Run `node scripts/setup-local.mjs` to create them and generate the local-only
# secrets, then follow docs/SETUP.md.
#
# Note: the backend also reads a root .env as a fallback (backend/.env wins).
# Keep this file empty or delete it, so old values cannot leak into the backend.
