# n8n automation – environment for automation/docker-compose.yml
# Copy to automation/.env and fill in YOUR OWN values. Never commit .env.
# Placeholders only. API keys/tokens for Groq, GitHub and Alertmanager are NOT
# set here: they are stored as n8n Credentials (encrypted in the n8n database).

# --- n8n itself ---------------------------------------------------------------
# Host address the n8n port is published on. Keep the default 127.0.0.1: only
# this computer can open n8n. For remote access (staging/production, or e.g.
# Alertmanager on a different host), keep 127.0.0.1 and put an HTTPS reverse proxy
# with appropriate access controls in front of n8n. Never set 0.0.0.0 to expose
# n8n directly: the editor and the webhooks would be reachable over plain HTTP.
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
# 32+ random characters. Encrypts the credentials stored in n8n. Keep a backup:
# losing it makes all saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Backend (Express) --------------------------------------------------------
# From inside the n8n container, the backend on your laptop is host.docker.internal.
BACKEND_BASE_URL=http://host.docker.internal:3000
# Same value as the backend's MACHINE_SIGNING_SECRET (32+ chars). Shared secret
# for HMAC-signed requests in both directions.
MACHINE_SIGNING_SECRET=change-me-same-value-as-backend-at-least-32-chars
# Timeout of every signed backend request (workflows 05, 06, 07), in ms (allowed 1000–60000).
BACKEND_TIMEOUT_MS=15000
# Workflow 06 retries the completion call (timeout / connection error / 5xx, max 3
# attempts, each signed again). Wait before retry n = this value x 2^(n-1) seconds (1–30).
COMPLETE_RETRY_BASE_SECONDS=2
# Path the backend signs when it calls n8n (POST <n8n>/webhook/remediation).
N8N_REMEDIATION_SIGNED_PATH=/webhook/remediation
# disabled = refuse remediation (default, the executor does not exist yet)
# simulate = record a clearly marked SIMULATED result (testing only)
REMEDIATION_EXECUTION_MODE=disabled

# --- Groq (key = n8n credential "Groq API") ------------------------------------
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Pick a current model from https://console.groq.com/docs/models and test it with workflow 00.
GROQ_MODEL=
GROQ_TIMEOUT_MS=30000

# --- Loki (logs) ----------------------------------------------------------------
LOKI_URL=http://host.docker.internal:3100
# Label that names the service in Loki: CONFIRM with the monitoring owner (Keshan).
LOKI_SERVICE_LABEL=service
LOKI_LOOKBACK_MINUTES=15
LOKI_AFTER_MINUTES=5
LOKI_MAX_LINES=200
# Timeout of the Loki query in workflow 02, in ms (allowed 1000–60000).
LOKI_TIMEOUT_MS=15000

# --- Prometheus (metrics) ---------------------------------------------------------
PROMETHEUS_URL=http://host.docker.internal:9090
# Label that names the service in Prometheus (usually the scrape job): CONFIRM with Keshan.
PROM_SERVICE_LABEL=job
PROM_BASELINE_OFFSET_MINUTES=30
PROM_ANOMALY_FACTOR=2
# Timeout of each Prometheus query in workflows 03 and 07, in ms (allowed 1000–60000).
PROMETHEUS_TIMEOUT_MS=10000
# Optional query overrides. {{service}} is replaced with the service name.
# cpu/memory default to prom-client's default metrics if left empty.
PROM_QUERY_CPU=
PROM_QUERY_MEMORY=
# These depend on the sample app's own metrics: agree them with Keshan, e.g.
# sum(rate(http_requests_total{job="{{service}}",status=~"5.."}[5m])) / sum(rate(http_requests_total{job="{{service}}"}[5m]))
PROM_QUERY_ERROR_RATE=
PROM_QUERY_LATENCY_P95=
PROM_QUERY_REQUEST_RATE=
# Optional absolute thresholds (same unit as the query result).
PROM_THRESHOLD_CPU=
PROM_THRESHOLD_MEMORY=
PROM_THRESHOLD_ERROR_RATE=
PROM_THRESHOLD_LATENCY_P95=

# --- Recovery check (workflow 07) ----------------------------------------------
RECOVERY_WAIT_SECONDS=60
RECOVERY_MAX_CHECKS=3
# true = "recovered" needs up==1 AND error rate <= PROM_THRESHOLD_ERROR_RATE
RECOVERY_REQUIRE_ERROR_RATE=true

# --- GitHub (token = n8n credential "GitHub API (read-only)") --------------------
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=AI-DevOps-CommandCenter
GITHUB_REPO=
DEPLOY_LOOKBACK_HOURS=24
DEPLOY_SUSPECT_MINUTES=60
DEPLOY_WORKFLOW_PATTERN=deploy|release|\bcd\b
# Timeout of each GitHub API request in workflow 04, in ms (allowed 1000–60000).
GITHUB_TIMEOUT_MS=15000

# --- Alert intake (workflow 01) -------------------------------------------------
# Alert label that names the service (fallbacks: service_name, job, app).
ALERT_SERVICE_LABEL=service
DEDUP_WINDOW_MINUTES=360
# An alert whose processing started but never finished (n8n crashed) is processed
# again after this many minutes (1–1440, never longer than DEDUP_WINDOW_MINUTES).
DEDUP_PENDING_MINUTES=15

# --- Error handler (workflow 09) ---------------------------------------------------
# Optional Slack or Discord incoming-webhook URL (it is a secret).
ERROR_NOTIFY_WEBHOOK_URL=
